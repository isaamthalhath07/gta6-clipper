# Copy to .env and fill in. Never commit .env.

# Twitch app (dev.twitch.tv/console -> Register Your Application, category "Application Integration")
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Claude (console.anthropic.com) - quality gate, cut refinement, titles. Optional.
ANTHROPIC_API_KEY=

# YouTube: Google Cloud project with "YouTube Data API v3" enabled, OAuth client of type Desktop app.
# Then: python -m clipper auth youtube
YT_CLIENT_ID=
YT_CLIENT_SECRET=

# TikTok: developers.tiktok.com app with Login Kit + Content Posting API (Direct Post), scope video.publish.
# Then: python -m clipper auth tiktok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# Instagram: Meta app with Instagram Graph API; IG professional account linked to a Facebook Page.
# Then: python -m clipper auth instagram --token <short-lived user token>
META_APP_ID=
META_APP_SECRET=
# or set these directly instead of running auth:
IG_ACCESS_TOKEN=
IG_USER_ID=
